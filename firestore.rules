rules_version = '2';

// Paste this in Firebase Console -> Firestore Database -> Rules -> Publish.
// Replace mudasiralisoomro15@gmail.com with the OWNER email (keep the quotes).
//
// Roles:
//   owner     = the email below. Can do everything, manages the admin team, approves requests.
//   full      = admin added in the panel (admins/<email> with role 'full'). Edits go live directly.
//   approval  = admin added in the panel with role 'approval'. Can READ admin data and send
//               change requests, but cannot write anything to the live site.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner() {
      return verified() && request.auth.token.email in ['mudasiralisoomro15@gmail.com'];
    }

    function hasAdminDoc() {
      return verified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role;
    }

    // Can change the live site / operations.
    function fullAdmin() {
      return owner() || (hasAdminDoc() && adminRole() == 'full');
    }

    // Can look at admin data (owner, full and approval admins).
    function anyAdmin() {
      return owner() || hasAdminDoc();
    }

    // Admin team: only the owner writes; an admin can read their own record.
    match /admins/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || anyAdmin());
      allow write: if owner();
    }

    // Edits suggested by "approval" admins. Only the owner can approve/reject.
    match /changeRequests/{requestId} {
      allow read: if anyAdmin();
      allow create: if anyAdmin()
                    && request.resource.data.requesterEmail == request.auth.token.email
                    && request.resource.data.status == 'pending';
      allow update, delete: if owner();
    }

    // Site settings (plans, prices, texts): everyone can read, owner/full admins can write.
    match /config/{docId} {
      allow read: if true;
      allow write: if fullAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || anyAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if fullAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || anyAdmin());
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Admins change anything. A customer may only (a) send the payment TXID for
      // their own order (pending/declined -> review) or (b) cancel it (pending/declined -> cancelled).
      allow update: if fullAdmin()
                    || (signedIn()
                        && resource.data.userId == request.auth.uid
                        && resource.data.status in ['pending', 'declined']
                        && request.resource.data.status == 'review'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'txid', 'txSubmittedAt', 'declineReason']))
                    || (signedIn()
                        && resource.data.userId == request.auth.uid
                        && resource.data.status in ['pending', 'declined']
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if fullAdmin();
    }

    match /coupons/{code} {
      allow get: if signedIn();
      allow list: if anyAdmin();
      allow write: if fullAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || anyAdmin());
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if fullAdmin();
    }

    match /kyc/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || anyAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending';
      allow update: if fullAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && resource.data.status == 'rejected'
                        && request.resource.data.status == 'pending');
      allow delete: if fullAdmin();
    }

    match /referrals/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.referredUid == uid
                    && request.resource.data.referrerId != uid;
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || request.auth.uid == uid || anyAdmin());
      allow update, delete: if fullAdmin();
    }

    match /commissions/{commissionId} {
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || anyAdmin());
      allow write: if fullAdmin();
    }
  }
}
