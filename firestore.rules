rules_version = '2';

// Paste this in Firebase Console -> Firestore Database -> Rules -> Publish.
// 1) Replace mudasiralisoomro15@gmail.com with your real admin email (keep the quotes).
// 2) The admin must log in with Google (or a verified email) to pass the check.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['mudasiralisoomro15@gmail.com'];
    }

    // Site settings (plans, prices, texts): everyone can read, only admin can write.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: each person can create/update only their own record (never change role).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Orders: a customer can create their own pending order and read their own orders.
    // Only admin can change status or delete.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Coupons: a signed-in customer can look up ONE code; only admin can list/write.
    match /coupons/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // Payout requests: customer creates (pending) and reads own; admin manages.
    match /payouts/{payoutId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // KYC: one document per user (id = uid). Users can never approve themselves.
    match /kyc/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && resource.data.status == 'rejected'
                        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Referrals: created once by the new user when they sign up via a link.
    match /referrals/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.referredUid == uid
                    && request.resource.data.referrerId != uid;
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Commissions are written only by admin; the referrer can read their own.
    match /commissions/{commissionId} {
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
